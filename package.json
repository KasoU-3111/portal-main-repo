{
  "name": "ibd-platform-monorepo",
  "private": true,
"scripts": {
  "dev:all": "npx concurrently \"npm run dev:hub\" \"npm run dev:doctor\" \"npm run dev:patient\" \"npm run dev:admin\"",
  "dev:hub": "npm --prefix apps/hub run dev -- --port 5173 --strictPort",
  "dev:doctor": "npm --prefix apps/doctor-portal run dev -- --port 8080 --strictPort",
  "dev:patient": "npm --prefix apps/patient-portal run dev -- --port 8081 --strictPort",
  "dev:admin": "npm --prefix apps/admin-portal run dev -- --port 8082 --strictPort"
},
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
